# AI DIAL Reverse Proxy
# Provides HTTPS termination + routing in front of DIAL services
:80 {
	# DIAL Chat UI
	handle /chat/* {
		reverse_proxy chat:3000
	}

	# DIAL Core API
	handle /api/* {
		reverse_proxy core:8080
	}

	# SBV — SMS Backup Viewer web UI
	handle /sbv/* {
		uri strip_prefix /sbv
		reverse_proxy sbv:8081
	}

	# Dockhand — Docker container management UI
	handle /dockhand/* {
		uri strip_prefix /dockhand
		reverse_proxy dockhand:3000
	}

	# Default: route everything to DIAL Core
	handle {
		reverse_proxy core:8080
	}
}
