# =============================================================================
# AI DIAL MCP Platform — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to source control.
# =============================================================================

# =============================================================================
# Core Infrastructure
# =============================================================================

# PostgreSQL
POSTGRES_PASSWORD=dial_password

# Keycloak admin credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password

# =============================================================================
# Cloudflare R2 Storage (S3-compatible)
# =============================================================================
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# =============================================================================
# LLM Providers
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key

# =============================================================================
# Neo4j (Knowledge Graph)
# =============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# =============================================================================
# Directus (User-Facing Data Surface) — opt-in via: docker compose --profile data up
# =============================================================================
# WARNING: Change ALL of these before deploying to any non-local environment.
DIRECTUS_KEY=supersecretkey-change-me-in-production
DIRECTUS_SECRET=supersecretdirsecret-change-me-in-production
DIRECTUS_ADMIN_EMAIL=admin@evidence.local
DIRECTUS_ADMIN_PASSWORD=admin_password_change_me

# =============================================================================
# Cloud Document Intelligence Engines (optional — only needed if using cloud engines)
# =============================================================================

# Google Document AI
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_DOCAI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCAI_LOCATION=us

# AWS Textract / Rekognition
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# LlamaCloud (LlamaParse)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key

# IBM watsonx.ai
WATSONX_API_KEY=your_watsonx_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# GLM-OCR (optional API key if using cloud endpoint instead of local GPU)
GLM_OCR_API_KEY=your_glm_ocr_api_key
GLM_OCR_ENDPOINT=http://localhost:8088

# =============================================================================
# SBV — SMS Backup Viewer (sidecar for XML import + web browsing)
# =============================================================================
# Internal URL used by the ts-mcp-server to call SBV's REST API.
# The web UI is also accessible via Caddy at http://localhost/sbv/
# or directly at http://localhost:8084/
SBV_URL=http://sbv:8081
SBV_USERNAME=
SBV_PASSWORD=

# =============================================================================
# Dockhand — Docker Container Management
# =============================================================================
# Dockhand is accessible via Caddy at http://localhost/dockhand/
# or directly at http://localhost:3007/
# On first access you will be prompted to create an admin account.
# Supports OIDC/SSO — can integrate with Keycloak for auth.
