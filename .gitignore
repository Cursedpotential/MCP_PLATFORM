# =============================================================================
# dial-stack .gitignore
# =============================================================================

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.venv*/

# Dependencies
dist/
build/
*.js.map
*.d.ts.map
*.tsbuildinfo

# Environment secrets
.env
.env.local
.env.*.local
.envrc
*.env
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*.out
*.err
core-logs/

# Data (never commit actual evidence)
data/
evidence/

# Docker volumes
pgdata/
ollama_models/
lancedb_data/
caddy_data/
caddy_config/

# Claude Code worktrees
.claude/worktrees/

# Hidden directories (dot dirs that aren't config)
.audit/
.full-review/
.planning/
.redline/
.annotative/
.plannotator/
.cursor/
.cachebro/
.qodo/
.logs/
.ruff_cache/
.mCP/
.mcp/
.memory/
.cache/
.agents/
.pytest_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage/
htmlcov/

# Special folders (2).plannotator
(2).plannotator/

# Git internals (already in .git)
.git/

# Semantica (use submodule instead)
docs/wiki/project-docs/components/tools/semantica/
docs/wiki/semantica-research/semantica/

# Temp files
temp_docs/
tmp-*
*.tmp
*.temp
*.bak
*.swp
*.swo
nul

# Lock files
*.lock

# Compiled TS (keep source only)
ts-mcp-server/src/*.js
ts-mcp-server/src/*.d.ts
ts-mcp-server/src/**/*.js
ts-mcp-server/src/**/*.d.ts
ts-mcp-server/dist/

# Utilities (large external libs)
utilities/mashumaro-master/

# Local databases and runtime artifacts
*.db
*.sqlite
*.sqlite3
*.duckdb
*.wal
*.shm
*.pid
